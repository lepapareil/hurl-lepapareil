{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hurl UI",
  "identifier": "dev.hurlui.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "dist",
    "additionalWatchFolders": [
      "../hurlui_core"
    ]
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Hurl UI",
        "width": 1280,
        "height": 800,
        "minWidth": 700,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Bruno-like desktop client for Hurl",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
